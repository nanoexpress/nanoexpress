{
  "eslint.validate": ["javascript"],
  "eslint.useFlatConfig": false,
  "js/ts.validate.enabled": true,
  "prettier.requireConfig": true,
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl"
  },
  "files.associations": {
    "*.js": "javascript",
    "*.d.ts": "typescript"
  }
}
