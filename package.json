{
  "name": "nanoexpress",
  "version": "6.4.4",
  "description": "Nano-framework for Node.js",
  "type": "module",
  "main": "src/nanoexpress.js",
  "exports": {
    ".": "./src/nanoexpress.js",
    "./Route": "./src/Route.js"
  },
  "typings": "nanoexpress.d.ts",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/dalisoft"
  },
  "scripts": {
    "lint": "ls-lint && biome check . && oxlint . && rumdl check .",
    "test": "node --test \"tests/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run lint && bun run test",
    "format": "biome check --write . && rumdl fmt ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanoexpress/nanoexpress.git"
  },
  "keywords": [
    "nano",
    "node",
    "fast",
    "uws",
    "websocket",
    "http",
    "c++"
  ],
  "author": "dalisoft",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nanoexpress/nanoexpress/issues"
  },
  "homepage": "https://github.com/nanoexpress/nanoexpress#readme",
  "dependencies": {
    "@dalisoft/events": "^0.2.0",
    "ajv": "^8.20.0",
    "cookie": "^0.7.0",
    "fast-query-parse": "^3.1.0",
    "uWebSockets.js": "https://github.com/uNetworking/uWebSockets.js/archive/refs/tags/v20.70.0.tar.gz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/cookie": "~0.6.0",
    "@types/node": "^26.6.3",
    "commitlint-config-airlight": "^6.0.5",
    "lefthook": "^2.1.15",
    "oxlint": "^1.86.0",
    "release-me-sh": "^0.11.12",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
